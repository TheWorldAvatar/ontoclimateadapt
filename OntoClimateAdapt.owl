        <rdfs:label>hasTopsoilWaterContent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#isDerivedFromEvent -->


    <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#isDerivedFromEvent">
        <rdfs:domain rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#NumberOfHeatwaveDays"/>
        <rdfs:range rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#Heatwave"/>
        <rdfs:comment>An object property that relates a derived quantitative indicator to one or more events from which the indicator has been computed or aggregated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>isDerivedFromEvent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#measuredAtHeight -->


    <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#measuredAtHeight">
        <rdfs:domain rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#NearSurfaceAirTemperature"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Height"/>
        <rdfs:comment>Relates a measurement to the height at which it was made.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>measuredAtHeight</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#measuredAtTime -->


    <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#measuredAtTime">
        <rdfs:domain rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#LandSurfaceTemperature"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment>The time instant when the temperatue was recorded.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
        <rdfs:label>measuredAtTime</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#measuredBy -->


    <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#measuredBy">
        <rdfs:domain rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimateChange"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sweetontology.net/reprSciModel/ClimateModel"/>
                    <rdf:Description rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#MeteorologicalStation"/>
                    <rdf:Description rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#SatelliteObservation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>The source of measurement, estimation, or observation through which evidence of climate change is obtained.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>measuredBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#occursAt -->


    <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#occursAt">
        <rdfs:domain rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#MeteorologicalExtremeEvent"/>
        <rdfs:range rdf:resource="http://sweetontology.net/propSpaceLocation/Location"/>
        <rdfs:comment>A relation linking an event to the geographical location where it takes place or manifests its observable impacts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>occursAt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#studiedBy -->


    <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#studiedBy">
        <rdfs:domain rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimateChange"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sweetontology.net/humanKnowledgeDomain/AtmosphericScience"/>
                    <rdf:Description rdf:about="http://sweetontology.net/humanKnowledgeDomain/Paleoclimatology"/>
                    <rdf:Description rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#EnvironmentalScience"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>The relationship between a natural or environmental phenomenon and the scientific disciplines that systematically investigate it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>studiedBy</rdfs:label>
    </owl:ObjectProperty>
    


