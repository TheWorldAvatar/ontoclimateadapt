        <rdfs:label>hasTopsoilBulkDensity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#hasTopsoilClayContent -->


    <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#hasTopsoilClayContent">
        <rdfs:domain rdf:resource="http://sweetontology.net/propSpaceLocation/Location"/>
        <rdfs:range rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#TopsoilClayContent"/>
        <rdfs:comment>Relates a Location to the TopsoilClayContent observed at that location.</rdfs:comment>
