    </owl:ObjectProperty>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#hasSubsoilSiltContent -->


    <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#hasSubsoilSiltContent">
        <rdfs:domain rdf:resource="http://sweetontology.net/propSpaceLocation/Location"/>
        <rdfs:range rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#SubsoilSiltContent"/>
