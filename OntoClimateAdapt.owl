    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#hasSubsoilTextureClass -->


    <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#hasSubsoilTextureClass">
        <rdfs:domain rdf:resource="http://sweetontology.net/propSpaceLocation/Location"/>
