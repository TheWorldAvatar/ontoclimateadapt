        <rdfs:domain rdf:resource="http://sweetontology.net/propSpaceLocation/Location"/>
        <rdfs:range rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#TopsoilBulkDensity"/>
        <rdfs:comment>Relates a Location to the TopsoilBulkDensity observed at that location.</rdfs:comment>
