    <owl:Class rdf:about="http://sweetontology.net/humanKnowledgeDomain/Paleoclimatology"/>
    


    <!-- http://sweetontology.net/phenEnvirImpact/OceanAcidification -->


    <owl:Class rdf:about="http://sweetontology.net/phenEnvirImpact/OceanAcidification"/>
    


    <!-- http://sweetontology.net/phenEnvirImpact/SeaLevelRise -->


    <owl:Class rdf:about="http://sweetontology.net/phenEnvirImpact/SeaLevelRise"/>
    


    <!-- http://sweetontology.net/phenPlanetClimate/ClimateChange -->


    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/ClimateChange">
        <rdfs:subClassOf rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#EarthSystemPhenomenon"/>
        <rdfs:subClassOf rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#EnvironmentalPhenomenon"/>
        <rdfs:comment>An Environmental Phenomenon that represents a persistent alteration in the statistical properties of the climate system.</rdfs:comment>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceLocation/Location -->


    <owl:Class rdf:about="http://sweetontology.net/propSpaceLocation/Location"/>
    


    <!-- http://sweetontology.net/propSpaceThickness/WaterContent -->


    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/WaterContent"/>
    


    <!-- http://sweetontology.net/reprSciModel/ClimateModel -->


    <owl:Class rdf:about="http://sweetontology.net/reprSciModel/ClimateModel">
        <rdfs:comment>A computational model that applies mathematical equations to simulate the behaviour of the Earth’s climate system.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>ClimateModel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Height -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Height"/>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Measure -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Temperature -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Temperature"/>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Unit -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
    


    <!-- http://www.opengis.net/ont/geosparql#Geometry -->


    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry"/>
    


    <!-- http://www.w3.org/2006/time#Instant -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#Instant"/>
    


    <!-- http://www.w3.org/2006/time#TemporalEntity -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalEntity"/>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#AdaptationMeasure -->


    <owl:Class rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#AdaptationMeasure">
        <rdfs:comment>A deliberate action, strategy, or intervention implemented to reduce the adverse impacts of climate change</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>AdaptationMeasure</rdfs:label>
    </owl:Class>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#AgeGroup -->


    <owl:Class rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#AgeGroup">
        <rdfs:comment>A group of people whose ages fall within a specified range.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>AgeGroup</rdfs:label>
    </owl:Class>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#AgeSpecificPopulationDensity -->


    <owl:Class rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#AgeSpecificPopulationDensity">
        <rdfs:subClassOf rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#PopulationDensity"/>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>AgeSpecificPopulationDensity</rdfs:label>
    </owl:Class>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#AnnualFrequency -->


    <owl:Class rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#AnnualFrequency">
        <rdfs:subClassOf rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#TemporalFrequency"/>
        <rdfs:comment>A temporal frequency representing the count of occurrences within a calendar year.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>AnnualFrequency</rdfs:label>
    </owl:Class>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#AvailableRootingDepth -->


    <owl:Class rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#AvailableRootingDepth">
        <rdfs:subClassOf rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#SoilProperty"/>
        <rdfs:comment>A SoilProperty representing the vertical depth of soil available for plant root growth and development at a specified location.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>AvailableRootingDepth</rdfs:label>
    </owl:Class>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#BulkDensity -->


    <owl:Class rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#BulkDensity">
        <rdfs:subClassOf rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#SoilProperty"/>
        <rdfs:comment>A SoilProperty representing the dry mass of soil per unit volume, including the volume occupied by pore spaces, at a specified location and, where applicable, at a specified time.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>BulkDensity</rdfs:label>
