    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#hasTemporalFrequency -->


    <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#hasTemporalFrequency">
        <rdfs:domain rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#NumberOfHeatwaveDays"/>
        <rdfs:range rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#TemporalFrequency"/>
        <rdfs:comment>An object property that links an observation to the temporal frequency at which the observed quantity is defined, measured, or aggregated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>hasTemporalFrequency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#hasTimeInterval -->


    <owl:ObjectProperty rdf:about="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#hasTimeInterval">
        <rdfs:domain rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl#NumberOfHeatwaveDays"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:comment>An object property that relates an aggregated observation result to the temporal interval over which it was computed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>hasTimeInterval</rdfs:label>
    </owl:ObjectProperty>
    


