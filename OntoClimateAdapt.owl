        <rdfs:comment>Relates a Location to the TopsoilOrganicCarbonContent observed at that location.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://raw.githubusercontent.com/TheWorldAvatar/ontoclimateadapt/main/OntoClimateAdapt.owl"/>
        <rdfs:label>hasTopsoilTextureClass</rdfs:label>
